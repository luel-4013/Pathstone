{
  "name": "pathstone",
  "version": "0.3.0",
  "description": "A calm, local-first workspace for tasks, projects, and a realistic day.",
  "license": "MIT",
  "author": "luel-4013",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luel-4013/Pathstone.git"
  },
  "bugs": {
    "url": "https://github.com/luel-4013/Pathstone/issues"
  },
  "homepage": "https://github.com/luel-4013/Pathstone#readme",
  "keywords": [
    "local-first",
    "offline-first",
    "task-manager",
    "planner",
    "pwa",
    "sqlite",
    "vanilla-javascript",
    "privacy",
    "electron",
    "appimage",
    "desktop"
  ],
  "private": true,
  "type": "commonjs",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "python3 server.py",
    "start:static": "python3 -m http.server 8247 --bind 127.0.0.1",
    "test": "node tests/test_pathstone.js && node tests/test_server_api.js && node tests/test_sqlite_service.js",
    "desktop:start": "electron-forge start",
    "desktop:package": "electron-forge package",
    "desktop:make": "electron-forge make",
    "desktop:dist": "node scripts/package-desktop.js",
    "desktop:dist:list": "node scripts/package-desktop.js --list"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@reforged/maker-appimage": "^6.0.0",
    "electron": "^45.3.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3"
  }
}
